# Environment and secrets — never commit real keys
env.txt
env*.txt
*env*.txt
.env
*.env
!env.txt.example

# Large data files — too big for GitHub
data/raw/
data/processed/*
data/models/*
data/odds/
data/archive/

# Keep these small reference files
!data/processed/.gitkeep
!data/raw/.gitkeep
!data/models/.gitkeep
!data/odds/.gitkeep
!data/archive/.gitkeep

# Prediction/model files needed for Streamlit Cloud deployment (kept in sync by launch.sh)
!data/processed/todays_yrfi_predictions.parquet
!data/processed/pitcher_nrfi_profile.parquet
!data/processed/top5_batter_stats.parquet
!data/processed/projected_top5_by_team.parquet
!data/processed/probable_pitchers.parquet
!data/models/yrfi_model.pkl

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/

# Logs
logs/
*.log

# Mac system files
.DS_Store
.DS_Store?
._*
.Spotlight-V5
.Trashes

# Streamlit
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Temporary files
*.tmp
*.temp
nohup.out